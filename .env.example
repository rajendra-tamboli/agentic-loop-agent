# Option 1: direct Anthropic API
ANTHROPIC_API_KEY=your-api-key-here

# Option 2: Claude Sonnet hosted in Azure AI Foundry, reached as a plain
# Anthropic-compatible endpoint (no CLAUDE_CODE_USE_FOUNDRY / Azure credential
# chain involved). Set these instead of ANTHROPIC_API_KEY above.
# AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/anthropic
# AZURE_FOUNDRY_API_KEY=your-azure-api-key
# AZURE_FOUNDRY_MODEL=your-sonnet-deployment-name
